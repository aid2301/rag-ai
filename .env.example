# Copy to .env; never commit real credentials.
# Required for Docker Compose; choose your own passwords.
ADMIN_PASSWORD=
PG_PASSWORD=
PG_USER=kb
PG_DATABASE=kb
PG_HOST=127.0.0.1
PG_PORT=55432
# Optional DSN override for non-Docker execution.
DATABASE_URL=

# Optional stable signing secret. If empty, generated into data/secret_key.
SECRET_KEY=

# Model configuration may also be saved through the admin UI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
DEFAULT_CHAT_MODE=auto
SHOW_THINKING=false

FULL_DOCUMENT_MAX_CHARS=12000
CONTEXT_BUDGET_CHARS=28000
SECTION_MAX_CHARS=4000
MAX_SELECTED_DOCUMENTS=5
MAX_RERANK_SECTIONS=20
TOP_SECTIONS_AFTER_RERANK=8
NEIGHBOR_RADIUS=1
MAX_UPLOAD_SIZE_MB=50

HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
